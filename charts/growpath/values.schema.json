{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "workingDir": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountToken": {
          "type": "boolean"
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "key": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "SecretStore",
                "ClusterSecretStore"
              ]
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "minLength": 1
          }
        }
      }
    },
    "reloader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/definitions/probe"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "boolean"
        },
        "zones": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "groupName": {
          "type": "string",
          "minLength": 1
        },
        "groupOrder": {
          "type": "integer"
        },
        "securityGroups": {
          "type": "string"
        },
        "tags": {
          "type": "string"
        },
        "healthcheckPath": {
          "type": "string",
          "pattern": "^/"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "pathType"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "pathType": {
                "enum": [
                  "Prefix",
                  "Exact",
                  "ImplementationSpecific"
                ]
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "securityGroups",
          "paths"
        ],
        "properties": {
          "securityGroups": {
            "minLength": 1
          },
          "paths": {
            "minItems": 1
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "interval": {
          "type": "string"
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ]
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "endpoint"
        ],
        "properties": {
          "endpoint": {
            "minLength": 1
          }
        }
      }
    },
    "mode": {
      "enum": [
        "service",
        "job"
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "if": {
    "properties": {
      "mode": {
        "const": "job"
      }
    },
    "required": [
      "mode"
    ]
  },
  "then": {
    "required": [
      "job"
    ],
    "properties": {
      "job": {
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "minItems": 1
          }
        }
      }
    }
  }
}
